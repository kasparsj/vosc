{
  "version": 2,
  "title": "GPU Particles",
  "size": [1024, 768],
  "onset_gate": 0,
  "commands": [
    {"address": "/layers/reset", "args": [{"type": "i", "value": 1}, {"type": "s", "value": "stack"}]},
    {"address": "/geom", "args": [{"type": "layer", "value": 0}, {"type": "s", "value": "box"}, {"type": "f", "value": 0.0015}, {"type": "f", "value": 0.0015}, {"type": "f", "value": 0.01}]},
    {"address": "/geom/set", "args": [{"type": "layer", "value": 0}, {"type": "s", "value": "meshMode"}, {"type": "i", "value": 0}]},
    {"address": "/geom/set", "args": [{"type": "layer", "value": 0}, {"type": "s", "value": "drawInstanced"}, {"type": "i", "value": 16384}]},
    {"address": "/tex", "args": [{"type": "s", "value": "particlesData"}, {"type": "source", "value": {"kind": "feedback", "path": "assets/particles/Update.frag"}}]},
    {"address": "/tex/size", "args": [{"type": "ref", "value": "particlesData"}, {"type": "i", "value": 128}, {"type": "i", "value": 128}]},
    {"address": "/tex/set", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "internalformat"}, {"type": "i", "value": 34836}]},
    {"address": "/tex/set", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "textureTarget"}, {"type": "i", "value": 3553}]},
    {"address": "/tex/set", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "wrapMode"}, {"type": "i", "value": 33071}]},
    {"address": "/tex/set", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "filter"}, {"type": "i", "value": 9728}]},
    {"address": "/tex/set", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "blendMode"}, {"type": "i", "value": 0}]},
    {"address": "/tex/var", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "timeStep"}, {"type": "f", "value": 0.016666666666666666}]},
    {"address": "/tex/var", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "particleMaxAge"}, {"type": "f", "value": 2.25}]},
    {"address": "/tex/var", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "noisePositionScale"}, {"type": "f", "value": 2.05}]},
    {"address": "/tex/var", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "noiseTimeScale"}, {"type": "f", "value": 0.727}]},
    {"address": "/tex/var", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "noisePersistence"}, {"type": "f", "value": 0.55}]},
    {"address": "/tex/var", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "noiseMagnitude"}, {"type": "f", "value": 0.05}]},
    {"address": "/tex/var", "args": [{"type": "ref", "value": "particlesData"}, {"type": "s", "value": "baseSpeed"}, {"type": "vector", "value": [{"type": "f", "value": 0.017}, {"type": "f", "value": 0.19}, {"type": "f", "value": 0.017}]}]},
    {"address": "/tex/data", "args": [{"type": "ref", "value": "particlesData"}, {"type": "vector", "value": [{"type": "i", "value": 0}, {"type": "i", "value": 0}, {"type": "i", "value": 0}, {"type": "s", "value": "rand(10.0)"}]}, {"type": "i", "value": 16384}]},
    {"address": "/shader", "args": [{"type": "layer", "value": 0}, {"type": "source", "value": {"kind": "stages", "stages": {"fragment": "assets/particles/DrawInstancedGeometry.frag", "vertex": "assets/particles/DrawInstancedGeometry.vert"}}}]},
    {"address": "/tex", "args": [{"type": "layer", "value": 0}, {"type": "ref", "value": "particlesData"}]},
    {"address": "/shader/var", "args": [{"type": "layer", "value": 0}, {"type": "s", "value": "particleMaxAge"}, {"type": "f", "value": 2.25}]},
    {"address": "/shader/var", "args": [{"type": "layer", "value": 0}, {"type": "s", "value": "particleStartColor"}, {"type": "vector", "value": [{"type": "f", "value": 0.050980392156862744}, {"type": "f", "value": 1.0}, {"type": "f", "value": 0.8627450980392157}, {"type": "f", "value": 1.0}]}]},
    {"address": "/shader/var", "args": [{"type": "layer", "value": 0}, {"type": "s", "value": "particleEndColor"}, {"type": "vector", "value": [{"type": "f", "value": 0.9411764705882353}, {"type": "f", "value": 0.2}, {"type": "f", "value": 0.6039215686274509}, {"type": "f", "value": 1.0}]}]},
    {"address": "/shader/var", "args": [{"type": "layer", "value": 0}, {"type": "s", "value": "texSize"}, {"type": "vector", "value": [{"type": "f", "value": 128.0}, {"type": "f", "value": 128.0}]}]},
    {"address": "/shader/var", "args": [{"type": "layer", "value": 0}, {"type": "s", "value": "baseSpeed"}, {"type": "vector", "value": [{"type": "f", "value": 0.017}, {"type": "f", "value": 0.19}, {"type": "f", "value": 0.017}]}]},
    {"address": "/cam", "args": [{"type": "s", "value": "default"}]},
    {"address": "/cam/set", "args": [{"type": "s", "value": "nearClip"}, {"type": "f", "value": 0.01}]},
    {"address": "/cam/pos", "args": [{"type": "i", "value": 0}, {"type": "f", "value": 0.4}, {"type": "f", "value": 1.1}]},
    {"address": "/cam/look", "args": [{"type": "i", "value": 0}, {"type": "f", "value": 0.2}, {"type": "i", "value": 0}]}
  ]
}
