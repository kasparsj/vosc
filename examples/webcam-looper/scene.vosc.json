{
  "version": 2,
  "title": "Webcam Looper",
  "size": [1024, 768],
  "onset_gate": 0,
  "inputs": {"camera": {"kind": "camera", "default": 0}},
  "commands": [
    {"address": "/layers/reset", "args": [{"type": "i", "value": 1}, {"type": "s", "value": "stack"}]},
    {"address": "/tex", "args": [{"type": "layer", "value": 0}, {"type": "source", "value": {"kind": "camera", "input": "camera"}}, {"type": "i", "value": 640}, {"type": "i", "value": 480}]}
  ]
}
