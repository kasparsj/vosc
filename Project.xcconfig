// Standard layout: <openFrameworks>/apps/myApps/vosc.
VOSC_PARENT_SDK = $(SRCROOT)/../../..
OF_PATH = $(VOSC_PARENT_SDK:standardizepath)
VOSC_ADDON_SDK = $(OF_PATH)
VOSC_ADDONS = $(VOSC_ADDON_SDK)/addons

ICON_NAME_DEBUG = icon-debug.icns
ICON_NAME_RELEASE = icon.icns
ICON_FILE_PATH = $(OF_PATH)/libs/openFrameworksCompiled/project/osx/

// The core build phase prepares the overlay before app sources compile.
VOSC_COMPAT_BUILD_DIR = $(PROJECT_TEMP_DIR)/vosc-of-$(VOSC_OF_VERSION)/$(CONFIGURATION)
MACOSX_DEPLOYMENT_TARGET = 12.6
CLANG_CXX_LIBRARY = libc++
CLANG_C_LANGUAGE_STANDARD = c17
CLANG_ENABLE_OBJC_ARC = YES
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) GL_SILENCE_DEPRECATION=1 GLES_SILENCE_DEPRECATION=1 COREVIDEO_SILENCE_GL_DEPRECATION=1 GLM_FORCE_CTOR_INIT GLM_ENABLE_EXPERIMENTAL
ARCHS = arm64
ENABLE_USER_SCRIPT_SANDBOXING = NO

#include "scripts/OpenFrameworks012.xcconfig"
#include? "Project.local.xcconfig"
