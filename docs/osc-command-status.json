  "/input": {
    "status": "supported",
    "canonical": "",
    "notes": "Create or reconfigure one OSC-fed slot with target alone. Supply device and optional channel count and buffer for a single device slot. Wildcard setup requires all fields. Wrapped setup is explicit.",
    "feature_flag": "",
    "replacement": "",
    "owner": "Inputs"
  },
  "/input/data": {
    "status": "supported",
    "canonical": "",
