  "/shader/var": {
    "status": "supported",
    "canonical": "",
    "notes": "For an active layer ivec2, ivec3, or ivec4 uniform, one JSON array takes exactly the reflected number of int32 values or expression strings. Active layer vec2, vec3, and vec4 uniforms take one JSON array of the reflected arity with float32 numbers or expression strings. Oversized vectors are rejected, and four vec4 components are used as raw values. Existing vec4 color bindings and ordinary ivec4-to-vec4 transitions accept three RGB components with alpha 1 and divide RGB by 255 when all three components are numeric and any exceeds 1. GLSL uniform arrays keep their existing handling.",
    "feature_flag": "",
    "replacement": "",
    "owner": "Shader"
  },
